{
  "name": "pathfinder-desktop",
  "version": "1.0.0",
  "description": "PathFinder AI Career Counselling — Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "build:mac": "electron-builder --mac dmg --arm64",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "in.pathfinder.desktop",
    "productName": "PathFinder",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules/.cache"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "identity": null
    },
    "dmg": {
      "title": "PathFinder Installer"
    }
  }
}
