# ─── Database ───────────────────────────────────────────────────────────────────
# Neon / Supabase / PostgreSQL connection strings:
# Direct connection (used by Prisma migrations and CLI)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"
# Optional connection pooler (e.g. Neon -pooler host) for high concurrency
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler:PORT/DB?sslmode=require"
# Optional explicit direct connection (defaults to DATABASE_URL)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require"

# ─── Server ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Sessions ────────────────────────────────────────────────────────────────────
SESSION_DAYS=30

# ─── Frontend ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins
FRONTEND_URL=http://localhost:5173

# ─── Gemini AI ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override default model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
